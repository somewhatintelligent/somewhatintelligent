{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "access:deploy": "alchemy deploy stacks/platform.access/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "access:destroy": "alchemy destroy stacks/platform.access/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "access:plan": "alchemy plan stacks/platform.access/alchemy.run.ts",
    "auth:deploy": "alchemy deploy stacks/platform.auth/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "auth:destroy": "alchemy destroy stacks/platform.auth/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "auth:plan": "alchemy plan stacks/platform.auth/alchemy.run.ts",
    "dev": "vp run website#dev",
    "mezedes:deploy": "vp run mezedes#build && alchemy deploy stacks/mezedes/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "mezedes:destroy": "alchemy destroy stacks/mezedes/alchemy.run.ts --stage $ALCHEMY_STAGE --yes",
    "mezedes:plan": "alchemy plan stacks/mezedes/alchemy.run.ts",
    "prepare": "vp config",
    "ready": "vp check && vp run -r test && vp run -r build"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "fallow": "3.10.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7",
    "alchemy": "2.0.0-beta.65",
    "effect": "4.0.0-beta.101",
    "@effect/platform-bun": "4.0.0-beta.101",
    "@effect/platform-node": "4.0.0-beta.101",
    "typescript": "7.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "arktype": "^2.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "19.2.4",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24",
    "zustand": "^5.0.12",
    "@types/react-dom": "19.2.4",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7",
    "tailwindcss": "^4"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.65": "patches/alchemy@2.0.0-beta.65.patch"
  }
}
