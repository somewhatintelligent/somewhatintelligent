---
// SSR: collection read at REQUEST time. This is the case that forces the
// content store into the SERVER bundle.
export const prerender = false;
import { getCollection } from "astro:content";
import Counter from "../components/Counter.svelte";
import Layout from "../layouts/Layout.astro";

const posts = await getCollection("blog");
const nonce = crypto.randomUUID();
const totalChars = posts.reduce((n, p) => n + (p.body?.length ?? 0), 0);

// Workers Cache is enabled on this Worker, so a dynamic route must opt OUT.
Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="content at request time">
  <h1>content at request time</h1>
  <p data-count={posts.length}>{posts.length} entries</p>
  <p data-chars={totalChars}>{totalChars} body characters</p>
  <p data-nonce={nonce}>{nonce}</p>

  <!-- Server-rendered island, hydrated from a chunk on the ASSETS layer. -->
  <Counter client:load start={7} />
</Layout>
