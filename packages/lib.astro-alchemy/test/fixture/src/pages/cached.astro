---
// Read-through Workers Cache sits IN FRONT of the Worker: with the cache
// enabled and a cacheable Cache-Control, repeat requests never reach this
// handler, so the nonce must freeze once the edge is warm.
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const nonce = crypto.randomUUID();
Astro.response.headers.set("Cache-Control", "public, max-age=300");
Astro.response.headers.set("Cache-Tag", "fixture-cached");
---

<Layout title="cached render">
  <h1>cached render</h1>
  <p data-nonce={nonce}>{nonce}</p>
</Layout>
