---
// PRERENDERED: collection read at build time -> becomes static HTML, so the
// Worker never sees these requests and middleware headers never appear.
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("blog");
const ordered = [...posts].sort(
  (a, b) => Number(a.id.replace(/\D/g, "")) - Number(b.id.replace(/\D/g, "")),
);
---

<Layout title="blog">
  <h1>blog</h1>
  <p data-count={ordered.length}>{ordered.length} entries</p>
  <ul>
    {ordered.map((post) => (
      <li><a href={`/blog/${post.id}`} data-post-id={post.id}>{post.data.title}</a></li>
    ))}
  </ul>
</Layout>
