---
// Server-rendered on every request. If this were prerendered or cached, the
// nonce would be identical across requests — that is the assertion.
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const nonce = crypto.randomUUID();
const cfRay = Astro.request.headers.get("cf-ray") ?? "no-cf-ray";
// Astro v6 removed Astro.locals.runtime.cf — the request carries it now.
const colo = (Astro.request as any).cf?.colo ?? "no-colo";

// Workers Cache is enabled on this Worker, so a dynamic route must opt OUT
// explicitly or the edge serves a cached render and SSR silently stops.
Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="per-request render">
  <h1>per-request render</h1>
  <dl>
    <dt>nonce</dt><dd data-nonce={nonce}>{nonce}</dd>
    <dt>cf-ray</dt><dd data-cf-ray={cfRay}>{cfRay}</dd>
    <dt>colo</dt><dd data-colo={colo}>{colo}</dd>
  </dl>
</Layout>
