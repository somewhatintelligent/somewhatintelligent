---
// Uses Astro.session, which the adapter wires to the Cloudflare KV session
// driver against the "SESSION" binding. If the stack does not declare that
// namespace in `env`, this must fail.
export const prerender = false;
import Layout from "../layouts/Layout.astro";

let value: number | undefined;
let error: string | undefined;

try {
  const current = (await Astro.session?.get<number>("count")) ?? 0;
  value = current + 1;
  await Astro.session?.set("count", value);
} catch (e) {
  error = e instanceof Error ? `${e.name}: ${e.message}` : String(e);
}
---

<Layout title="session counter">
  <h1>session counter</h1>
  <p data-count={value ?? "none"} data-error={error ?? "none"}>
    {error ? `session unavailable: ${error}` : `count: ${value}`}
  </p>
</Layout>
