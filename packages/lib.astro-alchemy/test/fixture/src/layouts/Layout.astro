---
// Deliberately bare. This fixture exists to prove Cloudflare behaviour, so
// every page carries only the `data-*` hooks its test reads.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
