{
  "name": "lib.astro-alchemy",
  "version": "0.0.0",
  "private": true,
  "description": "Astro SSR on Cloudflare Workers, as an Alchemy resource.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "sync": "astro sync --root test/fixture",
    "test": "bun test test/astro.test.ts",
    "test:dev": "bun test test/astro.local.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:fixture": "bun run sync && tsc --noEmit -p test/fixture/tsconfig.json"
  },
  "dependencies": {
    "alchemy": "catalog:"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/svelte": "^9.0.1",
    "@cloudflare/workers-types": "^5",
    "@effect/language-service": "^0.87.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "astro": "^7",
    "effect": "catalog:",
    "svelte": "^5.56.8",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7",
    "effect": "catalog:"
  }
}
