{
  "name": "lib.better-auth-effect",
  "version": "0.0.0",
  "description": "Better Auth's whole configuration surface, in Effect, with no knowledge of what backs it.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "purity": "bun run scripts/check-purity.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "better-auth": "^1.6.25",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "better-auth": "^1.6.25",
    "effect": "catalog:"
  }
}
