    {
      "name": "session",
      "path": "/v1/checkout/sessions",
      "method": "post",
      "params": {
        "mode": "payment",
        "success_url": "http://localhost:5173/orders/PROBE",
        "cancel_url": "http://localhost:5173/cart",
        "line_items": [
          {
            "price": "${price:id}",
            "quantity": 1
          }
        ],
        "metadata": {
          "storeOrderId": "FIXTURE_ORDER_ID"
        }
      }
    }
  ]
}
