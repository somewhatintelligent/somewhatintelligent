{
  "_meta": {
    "template_version": 0
  },
  "fixtures": [
    {
      "name": "product",
      "path": "/v1/products",
      "method": "post",
      "params": {
        "name": "Spike async-payment probe"
      }
    },
    {
      "name": "price",
      "path": "/v1/prices",
      "method": "post",
