{
  "extends": "../../tsconfig.effect.json",
  "compilerOptions": {
    "target": "esnext",
    /**
     * NO `DOM`, still. `@cloudflare/workers-types` supplies `Request`,
     * `Response`, `ReadableStream` and the rest, and adding `DOM` on top shadows
     * them with browser variants that disagree about `Request.cf` and R2 bodies.
     *
     * WHICH IS WHY THERE ARE NOW TWO PROJECTS. The operator console under
     * `app/` does render and does need `DOM`, so it carries its OWN
     * `app/tsconfig.json` — the nearest-ancestor config for every file in that
     * tree — and this one keeps the substrate's guarantee intact. `include`
     * below names the substrate's directories explicitly and `app/` is
     * deliberately absent from it; the two projects meet only where `app/`
     * imports `../module.ts` and `../domain/Contracts.ts` for their types.
     */
    "lib": ["esnext"],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun", "@cloudflare/workers-types"],
    "strict": true,
    /**
     * Carried over from the spike, and load-bearing rather than taste: the
     * domain indexes into query results and route segments constantly, and
     * every `as string` this would otherwise hide is a row that might not
     * exist. `noUnusedLocals` and `noUnusedParameters` are what kept the
     * handler tables honest while procedures were being added.
     */
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "module.ts",
    "paths.ts",
    "runtime.ts",
    /**
     * Named so it resolves under THIS project's `bundler` resolution. Left out,
     * the nearest config a language server finds for it is the repo root's,
     * which is `nodenext` — and the plugin packages it imports resolve only
     * under `bundler`, so every import in it reads as a missing module.
     */
    "vite.config.ts",
    "core/**/*.ts",
    "domain/**/*.ts",
    "infrastructure/**/*.ts",
    "services/**/*.ts",
    "workers/**/*.ts",
    /**
     * The test tree is IN the project, not beside it. The spike shipped a first
     * "clean" typecheck that had never seen `site/` because it was missing from
     * `include`; the deployed stack and the test-only stack both have to be
     * covered here or the same hole reopens.
     */
    "tests/**/*.ts"
  ]
}
