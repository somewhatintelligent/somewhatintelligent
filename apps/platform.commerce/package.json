{
  "name": "platform.commerce",
  "version": "0.0.0",
  "private": true,
  "description": "The commerce substrate: product lifecycle, checkout, settlement and fulfilment, served to the platform over a service binding.",
  "type": "module",
  "exports": {
    "./module": "./module.ts",
    "./AuthRouting": "./AuthRouting.ts",
    "./contracts": "./domain/Contracts.ts",
    "./rpc": "./domain/Rpc.ts",
    "./storefront": "./domain/Storefront.rpc.ts",
    "./workers/*": "./workers/*.ts",
    "./infrastructure/*": "./infrastructure/*.ts"
  },
  "scripts": {
    "test": "bun test tests/unit",
    "test:integ": "NO_DESTROY=1 bun test tests/settlement.integ.test.ts && NO_DESTROY=1 bun test tests/stripe.e2e.test.ts && bun test tests/store.integ.test.ts",
    "test:keep": "NO_DESTROY=1 bun test tests/settlement.integ.test.ts && NO_DESTROY=1 bun test tests/stripe.e2e.test.ts && NO_DESTROY=1 bun test tests/store.integ.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swi/infra": "workspace:*",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-start": "^1.166.15",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "^6.2.2",
    "lib.access-jwt": "workspace:*",
    "lib.observability": "workspace:*",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "platform.design": "workspace:*",
    "platform.names": "workspace:*",
    "platform.ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.118.0"
  }
}
