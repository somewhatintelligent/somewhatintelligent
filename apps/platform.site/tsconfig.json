{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@types/bun"],
    /**
     * REACT JSX, for `og/` and only `og/`. Astro's strict preset points
     * `jsxImportSource` at `astro`, which is right for a project whose `.tsx`
     * files are Astro islands — this project has none. Its only `.tsx` files
     * are the social-card definitions, which satori renders as React elements.
     * Repointing here rather than in a nested tsconfig keeps one project for
     * the editor and the type check to agree on.
     */
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
