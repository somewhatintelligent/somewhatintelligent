---
// THE PURCHASE SHEET — the right-hand column, and everything a shopper needs to
// decide and to buy.
//
// IN THE ORDER SOMEONE ACTUALLY READS IT: what this is, what it is called, what
// it is, what it costs, which size, buy. The optional panels sit under the buy
// control because they are what you open when the answer above was not enough,
// and shipping and returns are not among them — an operator who wants those
// said writes them into the description, where they are visible without a
// click rather than filed under a heading nobody opens.
//
// The route decides nothing about this column and this column decides nothing
// about the page's shape; `productView` decided both.
import { formatPrice } from "../lib/format.ts";
import { renderMarkdown } from "../core/markdown.ts";
import ProductPanels from "./ProductPanels.astro";
import ProductSizes from "./ProductSizes.astro";
import type { ProductView } from "../core/product-view.ts";
import type { StorefrontProductDTO } from "../lib/commerce.ts";

interface Props {
  product: StorefrontProductDTO;
  view: ProductView;
  /** Already decided by `availabilityLine` — the sheet states it, never derives it. */
  availability: string;
}

const { product, view, availability } = Astro.props;

/** Operator Markdown, rendered — see `core/markdown.ts`. */
const descriptionHtml = renderMarkdown(view.description);
---

<section
  class="product-sheet"
  data-slug={product.slug}
  data-title={product.title}
  data-price-cents={String(product.priceCents)}
  data-currency={product.currency}
  data-cover={view.media[0]?.href ?? ""}
>
  <p class="product-object-id">{view.identifier}</p>
  <h1 id="product-title">{product.title}</h1>

  {
    /*
      ALWAYS VISIBLE, directly under the title — never an accordion. It is the
      one piece of prose a shopper is guaranteed to read, so it is where an
      operator puts anything they need read, shipping and returns included.
    */
    descriptionHtml && <div class="product-description" set:html={descriptionHtml} />
  }

  <p class="product-price">{formatPrice(product.priceCents, product.currency)}</p>

  <ProductSizes variants={product.variants} />

  <p class="product-state" id="buy-state" aria-live="polite">{availability}</p>

  {/*
    THE ROUTE TO CHECKOUT, from the place the item was just added. The header's
    cart glyph is the persistent way there, but a shopper who just pressed "Add
    to cart" is looking HERE — and the only answer used to be a state line with
    no link in it. Ships `hidden`, revealed whenever the cart holds anything:
    same rule as the zoom openers, so a dead script shows a page without the
    affordance rather than a link into a cart that never renders.
  */}
  <a class="product-cart-link" id="view-cart" href="/cart/" hidden>View cart</a>

  <ProductPanels panels={view.panels} />
</section>
