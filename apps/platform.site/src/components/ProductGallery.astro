---
// THE GALLERY FIELD: a numbered filmstrip and one large plate. PHOTOGRAPHS ONLY
// — the size chart used to be dealt in here as a plate that took the
// photograph's place while `Size & fit` was open, which made a control in the
// right-hand column change the left-hand one. The chart belongs to the drawer
// that opens onto it and now lives there; see `ProductPanels.astro`.
//
// ORDER IS THE ENTIRE PRESENTATION MODEL. Index 0 is the listing cover and the
// shot this page opens on; the strip prints `01`, `02`, `03` beside the rest in
// exactly the order the operator arranged. Nothing branches on a role, because
// there is none to branch on.
//
// ONE IMAGE GETS NO STRIP. Not a strip of one, and not an empty second cell —
// the plate simply fills the whole field, which is what mockup 01 shows and
// what a single photograph deserves.
//
// EVERY SHOT IS RENDERED AND ONE IS SHOWN. Swapping `src` would re-request the
// bytes on every click and flash white in between; `hidden` on eight small
// elements costs nothing and makes the choice instant.
import type { ProductPlate } from "../core/product-view.ts";

interface Props {
  media: readonly ProductPlate[];
}

const { media } = Astro.props;

/** Derived, not passed: a consumer holding `media` can already see this. */
const showFilmstrip = media.length > 1;
---

<div class:list={["product-gallery", { "has-strip": showFilmstrip }]}>
  {
    showFilmstrip && (
      <nav class="product-filmstrip" aria-label="Product images">
        {media.map((plate, index) => (
          <button
            type="button"
            class="product-thumb"
            data-index={String(index)}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-label={`Image ${plate.label}: ${plate.alt}`}
          >
            <span class="product-thumb-index" aria-hidden="true">
              {plate.label}
            </span>
            <img src={plate.href} alt="" loading={index === 0 ? "eager" : "lazy"} />
          </button>
        ))}
      </nav>
    )
  }

  <div class="product-plate" data-plate>
    {
      media.map((plate, index) => (
        <figure class="product-shot" data-shot={String(index)} hidden={index !== 0}>
          <img src={plate.href} alt={plate.alt} loading={index === 0 ? "eager" : "lazy"} />

          {/*
            ONE OPENER PER SHOT rather than one on the plate reading whichever
            is visible. The button that enlarges image 02 carries image 02's
            href and its alt, so nothing has to ask the DOM what is currently
            shown and no answer can be stale — the same reason the filmstrip
            flips `hidden` instead of swapping a `src`.

            `hidden` UNTIL THE SCRIPT RUNS. It does nothing without its handler,
            and a control that does nothing is worse than no control; see
            `pages/shop/[slug].astro`, which reveals these.
          */}
          <button
            type="button"
            class="product-zoom-open"
            data-zoom-src={plate.href}
            data-zoom-alt={plate.alt}
            aria-label={`Enlarge image ${plate.label}`}
            hidden
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M10.4 10.4 14 14" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        </figure>
      ))
    }
  </div>
</div>
