---
// THE ACCORDIONS, and there are at most two of them.
//
// `<details name="product-panels">` rather than a hand-rolled disclosure: the
// shared `name` is the platform's own "only one open at a time", so the rule
// costs no JavaScript, no `aria-expanded` to keep in step with a class, and no
// focus management — a `<summary>` is already a keyboard-operable control in
// every engine. The page script closes siblings by hand only where `name` is
// unsupported, which is a progressive fallback rather than the mechanism.
//
// A PANEL EITHER EXISTS OR IT DOES NOT. `panels` is built by `productView` and
// contains no entry for an absent field, so nothing here branches on emptiness
// and no empty drawer can reach a page.
//
// THE `Size & fit` BODY CARRIES THE CHART AND THE FIT COMMENTS TOGETHER — the
// chart across the body, the comments beneath it. It used to displace the
// gallery photograph instead: a drawer in the right-hand column silently taking
// over the left-hand one, so the thing a shopper opened was not the thing that
// changed. Everything the panel is about is now inside the panel.
//
// The chart is the body's CONTENT rather than an illustration of it, which is
// why it gets the width and the prose sits under it.
import type { ProductPanel } from "../core/product-view.ts";

interface Props {
  panels: readonly ProductPanel[];
}

const { panels } = Astro.props;
---

{
  panels.length > 0 && (
    <div class="product-panels">
      {panels.map((panel) => (
        <details name="product-panels" class="product-panel" data-panel={panel.id}>
          <summary>
            <span>{panel.label}</span>
            {/* Decorative: the open state is already on the `<details>`. */}
            <svg class="product-panel-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M2 5.5 8 11l6-5.5" fill="none" stroke="currentColor" stroke-width="1.25" />
            </svg>
          </summary>
          <div class="product-panel-body">
            {/*
              THE CHART SPANS THE BODY, with the comments as prose beneath it
              rather than in a column beside it. Beside it the chart got about
              250px and its measurements rendered four pixels tall — legible in
              the mockup, which drew a simpler chart, and not legible with the
              real one. The full width roughly doubles it.

              THE CHART IS DRAWN IN THE PAGE'S OWN INK rather than in whatever
              colour it was exported as: its alpha channel is the artwork, so
              `product.css` masks it and paints the result `currentColor`. One
              file therefore reads correctly on this sheet in either theme, with
              no inverted second copy to keep in step and no white slab dropped
              into a dark panel to make black ink legible.

              `role="img"` + `aria-label` rather than `<img alt>` because a
              masked element is a background, and the alt text is the only thing
              a screen reader gets instead of the measurements — see
              `SizeGuide.alt` in the contract. `product.css` keeps a plain-image
              fallback for engines without mask support, so the chart is never
              invisible, only un-themed.

              The href is server-minted — `mediaHref(<ULID>)` — so it carries no
              characters that could escape the `url()`. It is not operator
              input.
            */}
            {panel.chart && (
              <div class="product-size-guide">
                <div
                  class="product-size-chart"
                  role="img"
                  aria-label={panel.chart.alt}
                  style={`--chart-src: url("${panel.chart.href}")`}
                />
              </div>
            )}

            {/*
              Unconditional, and no branch on the chart. An operator who wrote
              no comments has an empty array here, which maps to nothing — the
              same shape the details panel has, so neither panel's body is a
              special case of the other.
            */}
            {panel.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  )
}
