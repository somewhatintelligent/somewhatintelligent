---
// The shop composition, carried over. A drawn OBJECTS plane over a ledger of
// releases, one bordered row per object. The SVG title plane and the editorial
// "goods are arguments with sizing" note are site-owned compositional surfaces —
// layout, not document content; the document drives the accessible title, the
// deck, and what the ledger says when it is empty. The ROWS are catalogue data
// and never come from the document.
//
// A pure function of its props — the READ happens in the route, not here. Hand
// it a page of releases and the ledger renders; hand it an empty one and the
// plate does.
import SiteFooter from "../SiteFooter.astro";
import SiteHeader from "../SiteHeader.astro";
import LedgerEntry from "../LedgerEntry.astro";
import { formatPrice } from "../../lib/format.ts";
import type { ProductCardDTO } from "../../lib/commerce.ts";
import type { ShopDocument } from "../../lib/shop-document.ts";

interface Props {
  document: ShopDocument;
  products: readonly ProductCardDTO[];
  /**
   * Whether the catalogue answered. `false` is NOT "no products" — it is the
   * read having failed, and it renders different words so an outage cannot be
   * mistaken for an empty shop.
   */
  reachable?: boolean;
}

const { document: doc, products, reachable = true } = Astro.props;


/**
 * THE PLATE'S WORDS, decided here rather than branch-by-branch in the markup.
 *
 * Every field below answers the same question — did the catalogue reply? —
 * so asking it once yields one object instead of six ternaries interleaved
 * through the template, where a future edit can update five of them.
 */
const plate = reachable
  ? {
      heading: "No objects yet",
      body: doc.emptyMessage,
      status: "Unpublished",
      kicker: "unpublished",
      stamp: "COMING SOON",
      label: "No objects published",
    }
  : {
      heading: "Catalogue unavailable",
      body: doc.unavailableMessage,
      status: "Unreachable",
      kicker: "unreachable",
      stamp: "OFFLINE",
      label: "Catalogue unavailable",
    };
---

<div class="site-frame shop-frame">
  <SiteHeader />

  <main class="shop-main">
    <section class="objects-intro" aria-labelledby="objects-title">
      <h1 id="objects-title">
        <span class="sr-only">{doc.title}</span>
        <svg
          aria-hidden="true"
          class="objects-title-plane"
          preserveAspectRatio="none"
          viewBox="0 0 1000 1000"
        >
          <text x="20" y="912" font-size="1110" lengthAdjust="spacingAndGlyphs" textLength="930">
            OBJECTS
          </text>
        </svg>
      </h1>
      <p class="objects-deck">{doc.deck}</p>
      <p class="objects-note">goods are<br />arguments<br />with sizing.</p>
    </section>

    <section class="object-ledger" aria-label="Object releases">
      {
        products.length === 0 ? (
          <article class="object-entry object-entry-compact object-entry-placeholder">
            <span class="object-number">01</span>
            <div class="object-meta">
              <h2>{plate.heading}</h2>
              <p>{plate.body}</p>
              <dl>
                <div>
                  <dt>Status</dt>
                  <dd>{plate.status}</dd>
                </div>
                <div>
                  <dt>Price</dt>
                  <dd>—</dd>
                </div>
              </dl>
            </div>
            <div class="object-placeholder-field" aria-label={plate.label}>
              <span>Object / {plate.kicker}</span>
              <strong>{plate.stamp}</strong>
            </div>
          </article>
        ) : (
          /*
            THE FIRST ROW STARTS EXPANDED and the rest are registry lines until
            a pointer or the keyboard reaches them — see `LedgerEntry.astro`,
            which owns that behaviour and its markup in both states.

            `id` lives on the entry, so `/shop#slug` still lands on the object.
          */
          products.map((product, i) => (
            <LedgerEntry
              index={i + 1}
              slug={product.slug}
              title={product.title}
              priceLabel={formatPrice(product.priceCents, product.currency)}
              version={product.version}
              descriptionMarkdown={product.descriptionMarkdown}
              coverHref={product.coverHref}
              startExpanded={i === 0}
            />
          ))
        )
      }
    </section>
  </main>

  <SiteFooter />
</div>
