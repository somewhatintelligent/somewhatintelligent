---
// The writing index: a light cold-paper editorial page under the dark site
// chrome — WRITING masthead, an index table of arguments, and a panel beside
// the masthead carrying the active entry. One entry is active: the most recent
// on load; hovering or focusing any row makes that entry active with a
// crossfade. The light treatment is a token island — the route's root carries
// data-theme="light" so the generated token set's :root (cold paper) values
// apply inside it only.
//
// WHAT USED TO BE HERE AND IS NOT: an EVIDENCE rail of photographs down the
// right edge, and a REVISION column reading "revised" on every row above a
// three-entry changelog. The rail illustrated texts with objects that were not
// in them, and the changelog was a ledger nothing wrote to. What survived of
// revision is honest and lives on the text's own page: an "Updated" line, shown
// only when that text was actually revised.
//
// A pure function of its props — no binding, no fetch. Hand it an empty list
// and the coming-soon plate renders; hand it rows and the index does.
import type { WritingRow } from "../../core/writing-view.ts";
import { formatDate } from "../../lib/format.ts";

interface Props {
  heading: string;
  emptyMessage: string;
  rows: readonly WritingRow[];
}

const { heading, emptyMessage, rows } = Astro.props;

// The initially-active entry (most recent). Server-renders the panel; the hover
// script re-populates it from the JSON payload. With scripting off this is
// where the panel stays, which is a correct resting state rather than a
// degraded one.
const active = rows.length > 0 ? rows[0]! : null;
---

<main class="writing-index">
  {
    active === null ? (
      <div class="writing-empty">
        <p class="writing-empty-kicker">Text / public record</p>
        <strong>COMING SOON</strong>
        <p class="writing-empty-message">{emptyMessage}</p>
      </div>
    ) : (
      <div class="writing-content">
        <header class="writing-masthead">
          <div class="writing-masthead-left">
            <h1>{heading}</h1>
          </div>
          <div class="writing-masthead-active" data-fade>
            <p class="active-kicker" data-role="kicker">{active.title}</p>
            <p class="active-deck" data-role="deck">{active.deck}</p>
            <p class="active-meta">
              <span class="row-mono" data-role="meta">
                {formatDate(active.publishedAt)} · {active.kind} · {active.readingMinutes} min
              </span>
              <a class="active-link" data-role="href" href={active.href}>
                Read text →
              </a>
            </p>
          </div>
        </header>

        <div class="writing-table" role="table" aria-label="Published texts">
          <div class="writing-table-head" role="row">
            <span role="columnheader">Title</span>
            <span role="columnheader">Date ↓</span>
            <span role="columnheader">Kind</span>
            <span role="columnheader">Reading time</span>
            <span aria-hidden="true" />
          </div>
          {rows.map((row, i) => (
            <a
              class:list={["writing-row", { "is-active": i === 0 }]}
              data-entry={row.slug}
              href={row.href}
              role="row"
            >
              <span class="row-title" role="cell">
                {row.title}
              </span>
              <span class="row-mono" role="cell">
                {formatDate(row.publishedAt)}
              </span>
              <span class="row-mono" role="cell">
                {row.kind}
              </span>
              <span class="row-mono row-reading" role="cell">
                {row.readingMinutes} min
              </span>
              <span class="row-chevron" aria-hidden="true">
                ›
              </span>
            </a>
          ))}
        </div>

        <script
          type="application/json"
          data-writing-entries
          set:html={JSON.stringify(
            rows.map((row) => ({
              slug: row.slug,
              href: row.href,
              title: row.title,
              deck: row.deck,
              meta: `${formatDate(row.publishedAt)} · ${row.kind} · ${row.readingMinutes} min`,
            })),
          )}
        />
      </div>
    )
  }
</main>

<script>
  // Hovering or focusing a row makes its entry active: the masthead panel is a
  // SINGLE panel re-populated from the page's JSON payload, not one panel per
  // entry. Delegation binds on `document` so nothing has to be rebound.
  interface Entry {
    slug: string;
    href: string;
    title: string;
    deck: string;
    meta: string;
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const parsed = new WeakMap<Element, Map<string, Entry>>();

  function entriesFor(root: HTMLElement): Map<string, Entry> | null {
    const payload = root.querySelector("script[data-writing-entries]");
    if (!(payload instanceof HTMLElement) || !payload.textContent) return null;
    let map = parsed.get(payload);
    if (!map) {
      map = new Map((JSON.parse(payload.textContent) as Entry[]).map((e) => [e.slug, e]));
      parsed.set(payload, map);
    }
    return map;
  }

  function activate(root: HTMLElement, slug: string | undefined) {
    if (!slug) return;
    const entry = entriesFor(root)?.get(slug);
    if (!entry) return;

    const panel = root.querySelector<HTMLElement>(".writing-masthead-active");
    if (!panel) return;
    const role = (name: string) => panel.querySelector<HTMLElement>(`[data-role="${name}"]`);

    for (const row of root.querySelectorAll<HTMLElement>(".writing-row")) {
      row.classList.toggle("is-active", row.dataset.entry === slug);
    }

    const kicker = role("kicker");
    if (kicker) kicker.textContent = entry.title;
    const deck = role("deck");
    if (deck) deck.textContent = entry.deck;
    const meta = role("meta");
    if (meta) meta.textContent = entry.meta;
    const href = role("href");
    if (href instanceof HTMLAnchorElement) href.href = entry.href;

    if (!reducedMotion.matches) {
      panel.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 180, easing: "ease-out" });
    }
  }

  function activateFromEvent(target: EventTarget | null) {
    const row = target instanceof Element ? target.closest<HTMLElement>(".writing-row") : null;
    if (!row) return;
    const root = row.closest<HTMLElement>(".writing-index");
    if (root) activate(root, row.dataset.entry);
  }

  document.addEventListener("pointerover", (ev) => activateFromEvent(ev.target));
  document.addEventListener("focusin", (ev) => activateFromEvent(ev.target));
</script>

<style>
  .writing-index {
    min-height: 0;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* Fixed masthead; the index table is the ONLY scroll region. */
  .writing-content {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    padding: clamp(20px, 3vw, 44px) clamp(20px, 3vw, 48px);
  }

  .writing-masthead {
    flex-shrink: 0;
  }

  .writing-table {
    flex: 1;
    min-height: 180px;
    overflow-y: auto;
    border-top: 1px solid var(--color-border-strong);
  }

  .writing-table-head {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-background);
  }

  /* ── Masthead: FIXED height — content clamps inside it, so the band never
     resizes as the active entry changes under the cursor.

     Sized to the TALLEST thing it must hold, which is the right column at a
     three-line pull-quote (~190px), not to the wordmark. Anything more is gap
     between the wordmark and the table. */
  .writing-masthead {
    display: grid;
    grid-template-columns: minmax(0, 55%) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: start;
    height: clamp(158px, 21vh, 222px);
    overflow: hidden;
    padding-bottom: clamp(10px, 1.4vw, 18px);
  }

  .writing-masthead h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(72px, 11vw, 190px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.8;
    text-transform: uppercase;
  }

  /* Stretch to the band's fixed height so the hairline is constant even though
     the deck text inside varies. */
  .writing-masthead-active {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    border-left: 1px solid var(--color-border);
    padding-left: clamp(16px, 2vw, 32px);
    padding-top: 8px;
  }

  .active-kicker {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .active-deck {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-family: var(--font-editorial);
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.25;
  }

  .active-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    margin: auto 0 0;
    padding-top: 16px;
  }

  .active-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .active-link:hover,
  .active-link:focus-visible {
    color: var(--color-primary);
  }

  /* ── Index table ──────────────────────────────────────────────────────── */
  .writing-table-head,
  .writing-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 130px 90px 90px 28px;
    gap: 12px;
    align-items: center;
  }

  .writing-table-head {
    padding: 12px 0 10px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .writing-row {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .row-title {
    font-family: var(--font-editorial);
    font-size: clamp(17px, 1.6vw, 24px);
    font-weight: 650;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .row-mono {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted-foreground);
  }

  .writing-row.is-active .row-reading {
    color: var(--color-primary);
  }

  .writing-row:hover .row-title,
  .writing-row:focus-visible .row-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .row-chevron {
    justify-self: end;
    color: var(--color-muted-foreground);
  }

  /* ── Empty state ──────────────────────────────────────────────────────── */
  .writing-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    padding: 48px 24px;
    font-family: var(--font-mono);
  }

  .writing-empty strong {
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .writing-empty-kicker,
  .writing-empty-message {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  /* ── Narrow screens: natural page flow, nothing pinned ────────────────── */
  @media (max-width: 1023px) {
    .writing-content {
      display: block;
      height: auto;
      overflow: visible;
    }

    .writing-table {
      overflow-y: visible;
    }

    .writing-masthead {
      grid-template-columns: 1fr;
      height: auto;
      overflow: visible;
    }

    .writing-masthead-active {
      border-left: 0;
      padding-left: 0;
      margin-top: 24px;
    }

    .active-meta {
      margin-top: 16px;
    }

    .writing-table-head,
    .writing-row {
      grid-template-columns: minmax(0, 1fr) 100px 70px 24px;
    }

    .writing-table-head span:nth-child(3),
    .writing-row .row-mono:nth-of-type(2) {
      display: none;
    }
  }
</style>
