---
// The home composition, carried over verbatim. The SVG wordmark and the hero
// image are site-owned compositional surfaces — layout, not document content;
// the document drives the tagline, the section copy, and the action labels.
import SiteFooter from "../SiteFooter.astro";
import SiteHeader from "../SiteHeader.astro";
import type { HomeDocument } from "../../lib/home-document.ts";
// THE FILENAME IS THE PROVENANCE, kept verbatim from the product-image concept
// set it was generated in — the same rule the other two assets here follow,
// which carry their `brand-study/reference-images/` names unchanged. A file
// renamed on the way in is a file nobody can trace back to the note explaining
// what it is or why it was chosen.
import heroImage from "../../assets/01-virginia-data-center-alley-size-s-4x3.png";

interface Props {
  document: HomeDocument;
}

const { document: doc } = Astro.props;

/**
 * THE ORDER IS THE TAGLINE'S ORDER — "objects, texts, systems, & side effects".
 * The grid read objects / systems / texts / about, so the sentence directly
 * above it named the four in one sequence and the cards under it in another.
 *
 * It lives here rather than in `home-document.ts` because it is a fact about
 * this composition, not about the copy: the document is a bag of four named
 * sections and this decides where they sit. Reordering is an edit to a layout,
 * not a republish.
 */
const records = [
  { s: doc.sections.objects, href: "/shop/", id: "objects" },
  { s: doc.sections.texts, href: "/writing/", id: "texts" },
  { s: doc.sections.systems, href: "/software/", id: "systems" },
  { s: doc.sections.about, href: "/about/", id: "apostoli" },
];
---

<div class="site-frame">
  <SiteHeader />

  <main class="home-main">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-claim">
        <h1 id="home-title">
          <span class="sr-only">Somewhat Intelligent</span>
          <svg
            aria-hidden="true"
            class="claim-plane"
            preserveAspectRatio="none"
            viewBox="0 0 1000 1000"
          >
            <text x="30" y="500" font-size="650" lengthAdjust="spacingAndGlyphs" textLength="870">
              SOMEWHAT
            </text>
            <text x="30" y="960" font-size="650" lengthAdjust="spacingAndGlyphs" textLength="935">
              INTELLIGENT
            </text>
          </svg>
        </h1>
        <p class="publishing-scope">{doc.tagline}</p>
      </div>
      <figure class="hero-image">
        <img
          src={heroImage.src}
          alt="Friend 001 worn beside a red car at the edge of a data centre, with an open laptop carrying the somewhatintelligent wordmark"
        />
      </figure>
    </section>

    <section class="record-grid" aria-label="Current records">
      {
        records.map(({ s, href, id }) => (
          <article class="record" id={id}>
            <p class="record-label">{s.eyebrow}</p>
            <div class="record-visual record-scaffold" aria-hidden="true">
              <strong>{s.eyebrow}</strong>
            </div>
            <div class="record-copy">
              <p>{s.body}</p>
              <a href={href}>
                {s.actionLabel} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <SiteFooter />
</div>

<style>
  /*
   * THE RECORD ROW MEASURES ITSELF. It was pinned at `244px`, which had to be
   * tall enough for the tallest arrangement and was therefore too tall for
   * every other one. `auto` makes the row exactly the plate plus its margins,
   * and the hero — `minmax(0, 1fr)` — absorbs whatever that frees. One number
   * fewer to keep in step with the plate size.
   */
  .home-main {
    display: grid;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .hero {
    display: grid;
    min-height: 0;
    grid-template-columns: 48% 52%;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-claim {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--color-background);
  }

  .hero-claim h1 {
    position: absolute;
    inset: 0;
    color: var(--color-foreground);
  }

  .claim-plane {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .claim-plane text {
    fill: currentColor;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .publishing-scope {
    position: absolute;
    z-index: 3;
    bottom: 0;
    left: 0;
    width: fit-content;
    max-width: 100%;
    padding: 14px 30px 13px 24px;
    border-top-right-radius: 48px;
    background: var(--color-background);
    font-family: var(--font-editorial);
    font-size: clamp(18px, 1.35vw, 22px);
    line-height: 1.1;
    white-space: nowrap;
  }

  .hero-image {
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid var(--color-border);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 44%;
  }

  .record-grid {
    --record-scaffold-size: min(calc(10.5vw - 28px), 158px);
    /* The shared top edge, and the same value optically corrected for text. */
    --record-top: 36px;
    --record-cap: 33px;
    /* Clearance under the plate, and the band the action link sits in. */
    --record-foot: 16px;
    --record-action: 42px;

    display: grid;
    min-height: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .record {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: 48% 52%;
    gap: 0;
    overflow: hidden;
    border-right: 1px solid var(--color-border);
  }

  .record:last-child {
    border-right: 0;
  }

  .record-label {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 24px;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
  }

  /*
   * ── One shared top edge ──────────────────────────────────────────────────
   *
   * THE PLATE AND THE PROSE START ON THE SAME LINE, and `--record-top` is that
   * line. It was two numbers that happened to be near each other — the visual's
   * `margin-top: 40px` against the copy's `padding-top: 44px` — with the plate
   * then pushed to the BOTTOM of its cell by `align-self: end`, so the row had
   * to be tall enough for dead space above the plate plus the plate itself. The
   * text floated somewhere above the plate's top edge and lined up with nothing.
   *
   * Top-aligning the plate deletes that dead space, which is why the row gets
   * shorter rather than merely tidier: its height is now the plate plus the two
   * margins, and the hero above it takes back what the row gives up.
   *
   * `--record-cap` is the same line MINUS the 3px between a line box's top and
   * the top of a capital. Aligning the two boxes leaves the text looking low,
   * because a border is a hard edge and a cap is not; this aligns what the eye
   * actually sees.
   *
   * THE VERTICAL PLACEMENT IS SET ONCE, ON `.record-scaffold`, AND THAT MATTERS:
   * the template puts BOTH classes on the SAME element, so these two rules are
   * one element's cascade rather than a parent's and a child's. Equal
   * specificity means the later rule wins, which is why `.record-scaffold` used
   * to carry `margin-top: 0` — it was there to cancel a `margin-top` on
   * `.record-visual` that could never have applied. Two rules quietly fighting
   * over one box is how the plate ended up on top of its own label the first
   * time this was changed. Top and bottom live here; `.record-visual` keeps only
   * what the scaffold does not restate.
   */
  .record-visual {
    min-width: 0;
    margin-left: 14px;
    overflow: hidden;
  }

  .record-scaffold {
    position: relative;
    display: flex;
    width: var(--record-scaffold-size);
    height: var(--record-scaffold-size);
    align-self: start;
    align-items: center;
    justify-content: center;
    margin-top: var(--record-top);
    margin-bottom: var(--record-foot);
    margin-right: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
    font-family: var(--font-display);
    line-height: 0.82;
    text-align: center;
  }

  .record-scaffold::before,
  .record-scaffold::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 1px;
    background: var(--color-border);
    content: "";
  }

  .record-scaffold::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .record-scaffold::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .record-scaffold strong {
    position: relative;
    z-index: 1;
    padding: 7px 10px;
    background: var(--color-surface-sunken);
    font-family: var(--font-mono);
    font-size: clamp(16px, 1.45vw, 23px);
    font-weight: 400;
    line-height: 0.9;
  }

  /*
   * STRETCHED, DELIBERATELY, even though its text is top-aligned. The action
   * link is absolutely positioned against this cell, so the cell has to reach
   * the bottom of the record for `bottom` to mean the bottom of the record. Its
   * CONTENT starts at the shared top edge; its BOX still spans the row.
   */
  .record-copy {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--record-cap) 18px var(--record-action);
  }

  .record-copy p {
    font-family: var(--font-editorial);
    font-size: clamp(13px, 0.94vw, 15.5px);
    line-height: 1.15;
  }

  .record-copy a {
    position: absolute;
    bottom: 18px;
    left: 18px;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  @media (max-width: 1023px) {
    .home-main {
      display: block;
    }

    .hero {
      display: block;
      height: calc(100dvh - 56px);
      min-height: 620px;
    }

    .hero-claim {
      height: 100%;
    }

    .hero-image {
      display: none;
    }

    .publishing-scope {
      max-width: 92%;
      padding-left: 18px;
      font-size: clamp(17px, 4.8vw, 23px);
      white-space: normal;
    }

    .record-grid {
      --record-scaffold-size: calc(52vw - 28px);

      display: block;
    }

    .record {
      min-height: 294px;
      grid-template-columns: 52% 48%;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .record-label {
      left: 54%;
    }

    .record-copy {
      padding-right: 22px;
    }

    .record-copy p {
      font-size: 16px;
      line-height: 1.15;
    }
  }
</style>
