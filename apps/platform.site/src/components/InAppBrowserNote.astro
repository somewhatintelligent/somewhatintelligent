---
// THE IN-APP BROWSER NOTE — shown only inside one.
//
// Instagram and Facebook open links in their own embedded browser: the same
// engine as the phone's real one, a different environment — no console, no
// devtools, separate storage. Checkout has misbehaved there in ways it does
// not anywhere else, and an embedded browser CANNOT BE INSPECTED, so until the
// fault is named the honest move is the standard one: offer the phone's real
// browser. Detection is the user agent, which Meta's browsers all stamp.
//
// SHIPS `hidden`, REVEALED BY SCRIPT — the same rule as the zoom openers: a
// page whose script failed should look like a page without the feature, and
// everyone outside an embedded browser never knows this exists.
//
// THE CART TRAVELS IN THE LINK. Storage does not cross browsers, so escaping
// with a bare URL would arrive at an empty cart. While this note shows, the
// page's own URL carries the cart as a query parameter (`core/cart-link.ts`)
// — so Android's button and iOS's "Open in external browser" menu item, which
// both hand the CURRENT url to the real browser, arrive holding the same
// lines. The header's script imports the parameter on arrival and strips it.
---

<aside class="iab-note" id="iab-note" hidden>
  <p>
    <strong>You’re in an in-app browser.</strong>
    Checkout is more reliable in your phone’s own browser — your cart travels
    with the link.
  </p>
  <a class="iab-open" id="iab-open" href="/" hidden>Open in browser</a>
  <p class="iab-hint" id="iab-hint" hidden>
    Tap <strong>⋯</strong> and choose <strong>Open in external browser</strong>.
  </p>
  <button type="button" class="iab-dismiss" id="iab-dismiss" aria-label="Dismiss">×</button>
</aside>

<script>
  import { readCart, subscribeCart } from "../lib/cart.ts";
  import { CART_PARAM, serializeCart } from "../core/cart-link.ts";

  const note = document.getElementById("iab-note");
  const open = document.getElementById("iab-open") as HTMLAnchorElement | null;
  const hint = document.getElementById("iab-hint");
  const dismiss = document.getElementById("iab-dismiss");

  const ua = navigator.userAgent;
  /** Meta's embedded browsers all say so: Instagram by name, Facebook as FBAN/FBAV/FB_IAB. */
  const embedded = /Instagram|FBAN|FBAV|FB_IAB/i.test(ua);
  const android = /Android/i.test(ua);

  /** Dismissal lasts the session, not forever — and storage is guarded here like everywhere. */
  const DISMISSED = "si:iab:dismissed";
  const wasDismissed = (): boolean => {
    try {
      return window.sessionStorage.getItem(DISMISSED) === "1";
    } catch {
      return false;
    }
  };

  if (note && embedded && !wasDismissed()) {
    /**
     * The page's own URL carries the cart while the note shows, so EVERY route
     * out — the intent button, iOS's menu item, a copied link — carries it
     * too. Re-synced on every cart change; `replaceState`, so history gains no
     * entries and back still means back.
     */
    const sync = (): void => {
      const url = new URL(window.location.href);
      const lines = readCart();
      if (lines.length > 0) url.searchParams.set(CART_PARAM, serializeCart(lines));
      else url.searchParams.delete(CART_PARAM);
      history.replaceState(history.state, "", url);
      /**
       * `intent://` is Android's documented way out of an embedded browser —
       * it hands the URL to the system's default browser. iOS has no
       * programmatic escape at all, hence the menu instruction instead.
       */
      if (open) open.href = `intent://${url.host}${url.pathname}${url.search}#Intent;scheme=https;end`;
    };
    sync();
    subscribeCart(sync);

    if (android && open) open.hidden = false;
    if (!android && hint) hint.hidden = false;
    note.hidden = false;

    dismiss?.addEventListener("click", () => {
      note.hidden = true;
      try {
        window.sessionStorage.setItem(DISMISSED, "1");
      } catch {
        // Storage refused to remember; the note returns next page. Bearable.
      }
    });
  }
</script>
