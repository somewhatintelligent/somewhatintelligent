---
import { env } from "cloudflare:workers";
import { MARKET_COOKIE, MARKET_LABELS, parseMarket } from "../core/market.ts";

const NAV = [
  { section: "shop", href: "/shop/", label: "Shop" },
  { section: "software", href: "/software/", label: "Software" },
  { section: "writing", href: "/writing/", label: "Writing" },
  { section: "about", href: "/about/", label: "About" },
] as const;

const path = Astro.url.pathname;
const active =
  path === "/" ? "home" : (NAV.find(({ section }) => path.startsWith(`/${section}`))?.section ?? "");

const accountHref = `${env.AUTH_ORIGIN}/account`;

/**
 * The shopper's market, server-read so the switcher shows what the pages are
 * already priced in. Changing it reloads: the prices ARE the page, so there is
 * nothing meaningful to patch client-side.
 */
const market = parseMarket(Astro.cookies.get(MARKET_COOKIE)?.value);
---

<header class="site-header">
  <a
    class:list={["wordmark", { "is-active": active === "home" }]}
    href="/"
    aria-current={active === "home" ? "page" : undefined}
    aria-label="somewhatintelligent home"
  >
    somewhatintelligent
  </a>
  <nav class="desktop-nav" aria-label="Primary">
    {
      NAV.map(({ section, href, label }) => (
        <a
          class:list={{ "is-active": active === section }}
          href={href}
          aria-current={active === section ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
  <div class="header-end">
    <label class="market-switch">
      <span class="sr-only">Shipping to</span>
      <select id="site-market">
        {
          (Object.entries(MARKET_LABELS) as ["CA" | "US", string][]).map(([code, label]) => (
            <option value={code} selected={code === market}>
              {label}
            </option>
          ))
        }
      </select>
    </label>
    <a class="account-link" href={accountHref}>Account</a>
    {/*
     * ITS OWN CLASS, NOT `account-link`, and that is the whole of the bug this
     * fixes. The mobile block hides `.account-link` — correctly, for Account —
     * and the cart was wearing it, so a phone had no route to the cart at all
     * on a site whose entire purpose is selling. `.cart-link` survives the
     * breakpoint and drops only its text label.
     */}
    <a class="cart-link" id="site-cart-link" href="/cart/" aria-label="Cart, 0 items">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 7H6"></path>
        <circle cx="10" cy="20" r="1"></circle>
        <circle cx="18" cy="20" r="1"></circle>
      </svg>
      <span>Cart</span>
      <span id="site-cart-count">(0)</span>
    </a>
  </div>
</header>

<script>
  /**
   * THE COUNT, live. The cart is `localStorage` and nothing server-rendered can
   * know it, so the header ships `(0)` and this corrects it on load and on
   * every subsequent change — including a change made in ANOTHER TAB, which is
   * what `subscribeCart`'s storage listener is for.
   *
   * Until this existed, adding to the cart moved the state line on the product
   * page and left the header saying nothing at all.
   */
  import { cartCount, importCart, subscribeCart } from "../lib/cart.ts";
  import { CART_PARAM, parseCartParam } from "../core/cart-link.ts";

  /**
   * A CART CARRIED IN THE LINK, imported before the first count renders. This
   * is the receiving end of the in-app-browser escape hatch — see
   * `InAppBrowserNote.astro`: storage does not cross browsers, so the link
   * brings the lines. In the header rather than on one page because the
   * escape reopens whatever URL the shopper was on.
   *
   * THE PARAMETER IS STRIPPED ONCE READ. A URL that kept it would re-import on
   * every reload and shadow every later edit; the import itself only fills
   * gaps, so even an un-stripped copy cannot double a line.
   */
  const params = new URLSearchParams(window.location.search);
  const carried = params.get(CART_PARAM);
  if (carried !== null) {
    importCart(parseCartParam(carried));
    params.delete(CART_PARAM);
    const query = params.toString();
    history.replaceState(
      history.state,
      "",
      `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`,
    );
  }

  const link = document.getElementById("site-cart-link");
  const count = document.getElementById("site-cart-count");

  const render = (): void => {
    const n = cartCount();
    if (count) count.textContent = `(${n})`;
    link?.setAttribute("aria-label", `Cart, ${n} ${n === 1 ? "item" : "items"}`);
  };

  subscribeCart(render);
  render();
</script>
<script>
  /**
   * THE MARKET SWITCH. A cookie rather than storage because the SERVER prices
   * the pages — see `src/core/market.ts` — and a reload because the prices are
   * the page. `path=/` so the shop, the product pages and the cart all read
   * the same choice.
   */
  const select = document.getElementById("site-market") as HTMLSelectElement | null;

  /**
   * THE SELECTED OPTION, corrected on load — because not every page carrying
   * this header is rendered per request any more. The writing routes prerender,
   * and a prerendered page bakes in whatever `parseMarket(undefined)` returns
   * at build, so the control would sit on the default no matter what the
   * shopper had chosen. Reading the cookie here makes the switch tell the truth
   * on a static page without making the page dynamic.
   *
   * SSR pages are unaffected: the server already marked the right option and
   * this sets it to the value it is on. Same reason as the cart count above —
   * server-rendered chrome, corrected by the client where only the client
   * knows.
   */
  if (select) {
    const cookie = document.cookie.match(/(?:^|;\s*)si_market=(CA|US)\b/);
    if (cookie) select.value = cookie[1]!;
  }

  select?.addEventListener("change", () => {
    const value = select.value === "US" ? "US" : "CA";
    document.cookie = `si_market=${value}; path=/; max-age=31536000; samesite=lax`;
    window.location.reload();
  });
</script>
