---
// THE FOOTER SAYS THE NAME ONCE. The bottom-left used to be a third
// `somewhatintelligent` — after the header wordmark and the copyright line
// beside it — which is a corner of the page spent repeating something already
// on screen twice. It carries the two places the studio exists elsewhere
// instead.
//
// MARKS RATHER THAN WORDS. `GitHub` and `Instagram` set in the footer's 10px
// mono read as two more legal links; the marks are recognised without being
// read, which is the entire reason brands have them. The accessible name is on
// the anchor, so a screen reader still gets the word and the SVG stays
// `aria-hidden` — one name per link, not two.
//
// `rel="me"` because that is what these links MEAN: this profile is the same
// person as this site. It is the convention identity verifiers read, and it
// costs an attribute.
//
// No `target="_blank"`. Leaving for someone's GitHub or Instagram is a
// deliberate act, and deciding on a visitor's behalf that they wanted a second
// tab is the kind of help nobody asked for.
//
// THE HREFS COME FROM `platform.names`, and the marks stay here. The same two
// URLs are published as `sameAs` in the storefront's JSON-LD, which is one
// claim made in two vocabularies — made from two sources it becomes two claims,
// and the machine-readable one is the copy nobody would notice going stale. An
// SVG path is not a name, so it does not follow them into that package.
import { SOCIAL_PROFILES } from "platform.names";

const [github, instagram] = SOCIAL_PROFILES;
---

<footer class="site-footer">
  <nav class="site-social" aria-label="somewhatintelligent elsewhere">
    <a href={github.url} rel="me" aria-label={github.label}>
      {/* The official mark, filled — an outlined octocat is a smudge at 15px. */}
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
    </a>
    <a href={instagram.url} rel="me" aria-label={instagram.label}>
      {/*
        DRAWN, not the official path. The real glyph is one 2KB path that ships
        on every page of the site for a 15px mark; a rounded square, a circle
        and a dot is the same silhouette in a couple of hundred bytes and reads
        identically at this size.
      */}
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect
          x="2.6"
          y="2.6"
          width="18.8"
          height="18.8"
          rx="5.6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></rect>
        <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="17.7" cy="6.3" r="1.35" fill="currentColor"></circle>
      </svg>
    </a>
  </nav>
  <span>© 2026 somewhatintelligent</span>
  <nav class="site-legal" aria-label="Legal">
    <a href="/shipping">Shipping</a>
    <a href="/refunds">Refunds</a>
    <a href="/terms">Terms</a>
    <a href="/privacy">Privacy</a>
  </nav>
</footer>
