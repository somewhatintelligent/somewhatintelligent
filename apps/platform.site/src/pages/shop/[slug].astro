---
// One object, in one viewport.
//
// THE STAGE IS TWO FIELDS: the gallery on the left, the purchase sheet on the
// right. There is no notes rail under them any more — `Release / Sizing / Make
// / Returns` was four headings of boilerplate that pushed the buy control below
// the fold and said, between them, almost nothing an operator had written. What
// survived of it lives where an operator can actually author it: the
// description, which is always visible, and two optional panels they fill in or
// leave empty.
//
// EVERYTHING HERE IS THE ACTIVE RELEASE. Title, price, description, details,
// the size guide and the frozen image set all come from what was published; the
// SIZES are live, because inventory deliberately sits outside the release model
// — pinning stock into a release would resurrect sold-out sizes on republish.
import Base from "../../layouts/Base.astro";
import InAppBrowserDialog from "../../components/InAppBrowserDialog.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import ProductSheet from "../../components/ProductSheet.astro";
import ProductZoom from "../../components/ProductZoom.astro";
import { getStorefrontProduct } from "../../lib/commerce.ts";
import { availabilityLine, productView } from "../../core/product-view.ts";
import { paragraphs } from "../../core/markdown.ts";
import { MARKET_COOKIE, parseMarket } from "../../core/market.ts";
import { absoluteUrl } from "../../core/site.ts";
import {
  BRAND_NAME,
  breadcrumbs,
  graph,
  isoCurrency,
  majorUnits,
  organization,
  productNode,
  webPage,
} from "../../core/structured-data.ts";
import "../../styles/product.css";

const { slug } = Astro.params;
/** The shopper's market — it prices this page and 404s what is not sold there. */
const market = parseMarket(Astro.cookies.get(MARKET_COOKIE)?.value);

// A MISSING SLUG AND AN UNREACHABLE CATALOGUE ARE DIFFERENT ANSWERS. `null` is
// the domain saying no active release answers to this slug — a real 404. A
// throw is the binding failing, which is a 503: the object may well exist, and
// telling a crawler it is permanently gone would be a lie with consequences.
let product: Awaited<ReturnType<typeof getStorefrontProduct>> = null;
try {
  product = slug ? await getStorefrontProduct(slug, market) : null;
} catch (cause) {
  console.error("site.shop.product_failed", cause);
  return new Response(null, { status: 503 });
}
if (!product) return new Response(null, { status: 404 });

/**
 * EVERY DECISION THIS PAGE MAKES, made in one place and tested without a
 * renderer — whether there is a filmstrip, which panels exist, what each panel
 * holds. See `core/product-view.ts`; the markup below is the page's shape.
 */
const view = productView(product);
const availability = availabilityLine(product.variants);
/**
 * `view.description` IS A STRING, and both readers of it here used to treat it
 * as an array of paragraphs — it was one until `product-view.ts` started
 * carrying the raw Markdown instead. Indexing a string gave `<meta>` the first
 * CHARACTER of the description, and calling `.join` on one threw, which is what
 * took this page to a 500. The paragraph split belongs to whoever wants
 * paragraphs.
 */
const summary = paragraphs(view.description)[0];
const seoDescription = summary ?? `${product.title} — object by somewhatintelligent.`;

const origin = Astro.url.origin;
const path = `/shop/${product.slug}`;

/**
 * THE CARD IS THE OBJECT'S OWN PHOTOGRAPH, not the studio's wordmark plate.
 *
 * This is the one place a generated card would be the wrong answer. A shared
 * product link competes in a feed against every other picture in it, and the
 * shirt is a better picture of the shirt than a title set over black. The bytes
 * already exist, already sit behind an immutable cache header, and are already
 * the image the page opens on — index 0 is the listing cover by contract.
 *
 * NO `og:image:width`/`height`. The media worker streams whatever was uploaded
 * and nothing here has measured it; declaring dimensions we have not read is
 * how a card gets letterboxed by a platform that believed them.
 */
const cover = view.media[0];
const socialImage = cover ? { url: cover.href, alt: cover.alt } : undefined;

const inStock = product.variants.some((variant) => variant.available);

const jsonLd = graph([
  organization(origin),
  webPage({
    origin,
    path,
    name: product.title,
    description: seoDescription,
    type: "ItemPage",
    ...(cover ? { image: absoluteUrl(origin, cover.href) } : {}),
  }),
  breadcrumbs(origin, [
    { name: BRAND_NAME, path: "/" },
    { name: "Objects", path: "/shop" },
    { name: product.title },
  ]),
  productNode({
    origin,
    product,
    market,
    /** The whole description, not the first paragraph the `<meta>` is capped to. */
    description: view.description ?? seoDescription,
  }),
]);
---

<Base
  title={`${product.title} — somewhatintelligent`}
  description={seoDescription}
  ogType="product"
  image={socialImage}
  jsonLd={jsonLd}
  markdownAlternate
>
  {/*
    THE `product:` NAMESPACE, which is Open Graph's and not schema.org's.
    Facebook and Pinterest read these and neither reads JSON-LD; the price in a
    Pinterest rich pin comes from here or from nowhere. It duplicates the offer
    above because the two vocabularies have no overlap, not because either is
    redundant.
  */}
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(majorUnits(product.priceCents))} />
    <meta property="product:price:currency" content={isoCurrency(product.currency)} />
    <meta property="product:availability" content={inStock ? "in stock" : "out of stock"} />
    <meta property="product:condition" content="new" />
    <meta property="product:retailer_item_id" content={product.slug} />
  </Fragment>

  <div class="site-frame product-frame">
    <SiteHeader />

    <main class="product-main">
      <section class="product-stage" aria-labelledby="product-title">
        <ProductGallery media={view.media} />
        <ProductSheet product={product} view={view} availability={availability} />
      </section>
    </main>

    <SiteFooter />
  </div>

  {/*
    OUTSIDE THE FRAME, because `.site-frame` is a `100dvh` grid with
    `overflow: hidden` on the track that holds the page. A modal dialog is
    painted in the top layer regardless of where it sits in the tree, but
    keeping it out of a clipped subtree means nothing about this page's
    scroll discipline has to be relaxed to let it through.
  */}
  <ProductZoom />
  <InAppBrowserDialog />
</Base>

<script>
  /**
   * THE THREE THINGS THIS PAGE DOES CLIENT-SIDE, and no more.
   *
   *   1  choose a size, and add it to the cart;
   *   2  choose which photograph fills the gallery;
   *   3  open any image at full size in the viewer.
   *
   * There was another — swapping the gallery photograph for the size chart
   * while `Size & fit` was open. The chart is rendered inside the panel now, so
   * the accordion needs no script at all beyond the sibling-closing fallback
   * below, and the gallery answers to the filmstrip and nothing else.
   *
   * Scoped to this page's markup and bails when it is absent, so the handler is
   * a no-op on every other route. The cart stores only `{ variantId, quantity }`
   * — the hint written alongside it is a rendering snapshot for `/cart` and is
   * never sent anywhere, because checkout re-prices from the active release.
   */
  import { addLine, cartCount, subscribeCart } from "../../lib/cart.ts";

  const sheet = document.querySelector<HTMLElement>(".product-sheet[data-slug]");
  const addBtn = document.getElementById("add-to-cart") as HTMLButtonElement | null;
  const stateEl = document.getElementById("buy-state");
  const cartLink = document.getElementById("view-cart") as HTMLAnchorElement | null;
  const sizeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".product-size"));

  /**
   * THE ROUTE TO CHECKOUT, revealed whenever the cart holds anything — on
   * load, after an add here, after a change in another tab. Driven off the
   * cart rather than off the add button so it never claims a cart that is not
   * there, and never hides one that is.
   */
  const showCartLink = (): void => {
    if (!cartLink) return;
    const count = cartCount();
    if (count === 0) {
      cartLink.hidden = true;
      return;
    }
    cartLink.textContent = `View cart (${count})`;
    cartLink.hidden = false;
  };
  subscribeCart(showCartLink);
  showCartLink();

  let selected: { variantId: string; size: string } | null = null;

  for (const button of sizeButtons) {
    if (button.disabled) continue;
    button.addEventListener("click", () => {
      selected = {
        variantId: button.dataset.variant ?? "",
        size: button.dataset.size ?? "",
      };
      for (const other of sizeButtons) {
        other.setAttribute("aria-pressed", other === button ? "true" : "false");
      }
      if (addBtn) addBtn.disabled = false;
      if (stateEl) stateEl.textContent = `Size ${selected.size} selected.`;
    });
  }

  addBtn?.addEventListener("click", () => {
    if (!selected || !sheet) return;
    addLine(selected.variantId, 1, {
      slug: sheet.dataset.slug ?? "",
      title: sheet.dataset.title ?? "",
      size: selected.size,
      priceCents: Number(sheet.dataset.priceCents ?? "0"),
      currency: sheet.dataset.currency ?? "cad",
      coverHref: sheet.dataset.cover ? sheet.dataset.cover : null,
    });
    if (stateEl) {
      const count = cartCount();
      stateEl.textContent = `Added. ${count} ${count === 1 ? "item" : "items"} in the cart.`;
    }
  });

  /**
   * THE FILMSTRIP. Every shot is already in the document; choosing one is a
   * `hidden` flip rather than a `src` swap, so there is no re-request and no
   * white flash between two photographs of the same shirt.
   */
  const shots = Array.from(document.querySelectorAll<HTMLElement>("[data-shot]"));
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".product-thumb"));

  /**
   * ONE FACT DECIDES WHAT THE FIELD SHOWS: which thumbnail was pressed. It used
   * to be two — the selected shot AND whether the chart had displaced it — and
   * the reconciling function that read both is gone with the displacing.
   */
  thumbs.forEach((thumb, index) => {
    thumb.addEventListener("click", () => {
      for (const other of thumbs) {
        other.setAttribute("aria-pressed", other === thumb ? "true" : "false");
      }
      shots.forEach((shot, i) => {
        shot.hidden = i !== index;
      });
    });
  });

  /**
   * ONE PANEL OPEN AT A TIME, and this is the FALLBACK for engines without
   * `<details name>` rather than the mechanism. Where the attribute is
   * supported this never finds a second open panel, because the browser closed
   * it first; running it either way means the behaviour does not depend on
   * which of the two happened.
   *
   * Driven off `toggle`, which fires for every route into the open state: a
   * click on the summary, `Enter` on it, a sibling closing this one, and
   * find-in-page opening it. A click handler would miss three of those.
   */
  const panels = Array.from(document.querySelectorAll<HTMLDetailsElement>(".product-panel"));

  for (const panel of panels) {
    panel.addEventListener("toggle", () => {
      if (!panel.open) return;
      for (const other of panels) {
        if (other !== panel) other.open = false;
      }
    });
  }

  /**
   * THE FULL-SIZE VIEWER. Every opener carries its own `src` and `alt`, so
   * this reads the button that was pressed and never asks the page which image
   * is currently showing — there is no state here to fall out of step.
   *
   * THE OPENERS SHIP `hidden` AND ARE REVEALED HERE. They do nothing without
   * this handler, and a magnifying glass that does not magnify is worse than no
   * magnifying glass; a page whose script failed to load should look like a
   * page without the feature rather than one with a broken control.
   *
   * `showModal()` rather than `show()`: it is the modal form that traps focus,
   * makes the rest of the document inert, renders a real `::backdrop` and
   * closes on `Esc`. All four are behaviours we would otherwise be writing, and
   * writing worse.
   */
  const zoom = document.querySelector<HTMLDialogElement>("dialog[data-zoom]");
  const zoomImage = zoom?.querySelector<HTMLImageElement>("[data-zoom-image]") ?? null;

  if (zoom && zoomImage) {
    for (const opener of document.querySelectorAll<HTMLButtonElement>("[data-zoom-src]")) {
      opener.hidden = false;
      opener.addEventListener("click", () => {
        zoomImage.src = opener.dataset.zoomSrc ?? "";
        zoomImage.alt = opener.dataset.zoomAlt ?? "";
        /**
         * Line art needs a white ground; a photograph does not. The opener
         * says which it is, because the opener is the only thing that knows.
         */
        zoom.classList.toggle("on-plate", "zoomPlate" in opener.dataset);
        zoom.showModal();
      });
    }

    /**
     * CLICKING THE BACKDROP CLOSES IT. `::backdrop` is not an element and
     * cannot take a listener, but a click on it targets the dialog itself —
     * whereas a click on the image or the close button targets those. So
     * `event.target === zoom` is precisely "outside the content", with no
     * hit-testing of our own.
     */
    zoom.addEventListener("click", (event) => {
      if (event.target === zoom) zoom.close();
    });

    /**
     * Dropping the `src` on close so a large photograph is not held decoded
     * for a page the visitor has gone back to reading. It costs a cache hit to
     * reopen and nothing to leave.
     */
    zoom.addEventListener("close", () => {
      zoomImage.removeAttribute("src");
      zoomImage.alt = "";
    });
  }
</script>
