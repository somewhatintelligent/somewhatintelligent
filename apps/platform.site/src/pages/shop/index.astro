---
import Base from "../../layouts/Base.astro";
import ShopView from "../../components/views/ShopView.astro";
import { SHOP_DOCUMENT } from "../../lib/shop-document.ts";
import { listStorefrontOrEmpty } from "../../lib/commerce.ts";
import { MARKET_COOKIE, parseMarket } from "../../core/market.ts";
import { BRAND_NAME, breadcrumbs, graph, itemList, organization, webPage } from "../../core/structured-data.ts";
import "../../styles/shop.css";

// Copy/SEO come from the committed document rather than the Publisher page read
// this route used to perform — see `src/lib/shop-document.ts`. The LEDGER ROWS
// come from commerce over the service binding, each sourced from a product's
// ACTIVE RELEASE, so an operator's unpublished draft edit changes nothing here.
const doc = SHOP_DOCUMENT;

// AN EMPTY SHOP AND AN UNREACHABLE ONE ARE DIFFERENT PAGES, which is why the
// failure is caught rather than left to propagate. Letting it throw serves
// Astro's 500 with the site chrome gone; swallowing it into an empty list tells
// a shopper the shop is empty when it is broken — the version nobody reports.
// The 503 is how anything that is not a human finds out.
// WHICH SHOP THIS IS. The market cookie decides the prices this page renders
// — and what it hides: a product with no live row for this market is not in
// this market's shop at all.
const market = parseMarket(Astro.cookies.get(MARKET_COOKIE)?.value);

const { products, reachable } = await listStorefrontOrEmpty(market, "shop");
// The 503 is how anything that is not a human finds out. See `lib/commerce.ts`
// for why the read itself no longer decides this.
if (!reachable) Astro.response.status = 503;

const origin = Astro.url.origin;

/**
 * ADDRESSES, NOT PRODUCTS. The full `Product` markup lives on the page that can
 * be bought from — see `core/structured-data.ts#itemList`. When the catalogue
 * is unreachable the list is empty rather than absent, which is the honest
 * statement of what this render knows.
 */
const jsonLd = graph([
  organization(origin),
  webPage({
    origin,
    path: "/shop",
    name: doc.seo.title,
    description: doc.seo.description,
    type: "CollectionPage",
  }),
  breadcrumbs(origin, [{ name: BRAND_NAME, path: "/" }, { name: "Objects" }]),
  itemList(origin, products),
]);
---

<Base
  title={doc.seo.title}
  description={doc.seo.description}
  jsonLd={jsonLd}
  markdownAlternate
>
  <ShopView document={doc} products={products} reachable={reachable} />
</Base>
