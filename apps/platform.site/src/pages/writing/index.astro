---
// PRERENDERED, unlike most of this site. The texts are files in the repository
// and the page is the same for everyone, so it is built once and served off the
// asset layer with no Worker invocation. `output: "server"` is forced by the
// stack; this route opts out of it.
//
// The adapter prerenders inside workerd (`prerenderEnvironment: "workerd"`),
// so the site chrome's binding reads resolve at build like they do at request
// time. What does NOT survive prerendering is per-request state — the header's
// market cookie — which is why `SiteHeader` sets that control client-side.
import Base from "../../layouts/Base.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import WritingIndex from "../../components/views/WritingIndex.astro";
import { WRITING_DOCUMENT } from "../../lib/writing-document.ts";
import { publishedRows } from "../../core/writing-view.ts";
import { getCollection } from "astro:content";

export const prerender = true;

const doc = WRITING_DOCUMENT;
const rows = publishedRows(
  (await getCollection("writing")).map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    deck: entry.data.deck,
    kind: entry.data.kind,
    date: entry.data.date,
    updated: entry.data.updated,
    draft: entry.data.draft,
    body: entry.body ?? "",
  })),
  { includeDrafts: import.meta.env.DEV },
);
---

<Base title={doc.seo.title} description={doc.seo.description} theme="light">
  <div class="site-frame">
    <div data-theme="dark" style="display: contents;">
      <SiteHeader />
    </div>
    <WritingIndex heading={doc.heading} emptyMessage={doc.emptyMessage} rows={rows} />
    <div data-theme="dark" style="display: contents;">
      <SiteFooter />
    </div>
  </div>
</Base>
