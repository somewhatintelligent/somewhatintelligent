---
// ON-DEMAND, though every fact on it is committed to this repository.
//
// It was prerendered for exactly one commit, and the metadata layer is why it
// is not. `Base` derives the canonical, `og:url`, `og:image` and the markdown
// alternate from `Astro.url.origin` ON PURPOSE — see `core/site.ts`: the Worker
// answers on workers.dev in every stage and on the apex only in production, so
// a build-time origin would make a stage emit canonicals pointing at
// production. Prerendering has no request to take an origin from, so it would
// bake a placeholder into all four. Astro's `site` option would settle this —
// a per-stage value is a fact, not a guess — but that is stack plumbing, not
// something to smuggle into a merge.
import Base from "../../layouts/Base.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import WritingIndex from "../../components/views/WritingIndex.astro";
import { WRITING_DOCUMENT } from "../../lib/writing-document.ts";
import { publishedRows } from "../../core/writing-view.ts";
import { pageGraph } from "../../core/structured-data.ts";
import { getCollection } from "astro:content";

const doc = WRITING_DOCUMENT;
const rows = publishedRows(
  (await getCollection("writing")).map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    deck: entry.data.deck,
    kind: entry.data.kind,
    date: entry.data.date,
    updated: entry.data.updated,
    draft: entry.data.draft,
    body: entry.body ?? "",
  })),
  { includeDrafts: import.meta.env.DEV },
);

const origin = Astro.url.origin;

const jsonLd = pageGraph({
  origin,
  path: "/writing",
  name: doc.seo.title,
  description: doc.seo.description,
  crumb: doc.heading,
  type: "CollectionPage",
});
---

<Base
  title={doc.seo.title}
  description={doc.seo.description}
  theme="light"
  jsonLd={jsonLd}
  markdownAlternate
>
  <div class="site-frame">
    <div data-theme="dark" style="display: contents;">
      <SiteHeader />
    </div>
    <WritingIndex heading={doc.heading} emptyMessage={doc.emptyMessage} rows={rows} />
    <div data-theme="dark" style="display: contents;">
      <SiteFooter />
    </div>
  </div>
</Base>
