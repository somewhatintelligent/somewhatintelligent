---
import Base from "../layouts/Base.astro";
import TxShell from "../components/TxShell.astro";
import { pageGraph } from "../core/structured-data.ts";

// Refund policy. Static legal/informational page linked from the site footer.

const TITLE = "Refunds — somewhatintelligent";
const DESCRIPTION = "Returns and refunds for somewhatintelligent orders.";

const jsonLd = pageGraph({
  origin: Astro.url.origin,
  path: "/refunds",
  name: TITLE,
  description: DESCRIPTION,
  crumb: "Refunds",
});
---

<Base title={TITLE} description={DESCRIPTION} jsonLd={jsonLd}>
  <TxShell title="Refunds" maxWidth={640}>
    <div class="legal">
      <p class="legal-updated">Last updated August 2026.</p>
      <p>
        Say something within 30 days of delivery and we will make it right. What "right" looks like
        depends on what went wrong — the two cases below are different on purpose.
      </p>
      <h2>Damaged or defective</h2>
      <p>
        Send a photo with your order number and we refund or replace, your choice. You keep the
        item — we will not ask you to post a defective shirt across a border so we can look at it.
      </p>
      <h2>Sizing</h2>
      <p>
        Exchange only. Reply to your order confirmation with the size you need and we send
        instructions. The item must be unworn and unwashed. Cross-border return shipping is on you;
        the replacement ships free.
      </p>
      <h2>Refund timing</h2>
      <p>
        Refunds go to the original payment method. Your bank may take several business days to post
        the credit.
      </p>
      <h2>Pre-orders</h2>
      <p>
        A pre-order can be cancelled for a full refund any time before it ships. After that, the
        two cases above apply.
      </p>
    </div>
  </TxShell>
</Base>

<style>
  .legal p {
    margin-top: 16px;
  }

  .legal-updated {
    margin-top: 0;
    color: var(--color-muted-foreground);
  }

  .legal h2 {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted-foreground);
  }

  .legal a {
    text-decoration: underline;
  }
</style>
