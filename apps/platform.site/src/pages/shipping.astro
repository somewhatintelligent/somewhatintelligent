---
import Base from "../layouts/Base.astro";
import TxShell from "../components/TxShell.astro";

// Shipping policy. Static legal/informational page linked from the site footer.
---

<Base
  title="Shipping — somewhatintelligent"
  description="How and when somewhatintelligent orders ship."
>
  <TxShell title="Shipping" maxWidth={640}>
    <div class="legal">
      <p class="legal-updated">Last updated August 2026.</p>
      <p>
        Shipping is included in the price. There is no shipping line at checkout, no threshold to
        clear, and nothing added at the door.
      </p>
      <h2>Where and when</h2>
      <p>
        We ship to Canada and the United States. Canadian orders typically arrive within 3–8
        business days of shipping; US orders within 5–12. Pre-order items ship when the run is made
        — the expected window is shown on the product page and on your order.
      </p>
      <p>
        Orders are processed within two business days. You receive a confirmation with tracking
        once your order leaves our hands.
      </p>
      <h2>Duties and taxes — United States</h2>
      <p>
        Duties are prepaid. Your parcel arrives with nothing to pay on delivery — no customs bill,
        no carrier brokerage fee, no surprise at the door. The price you see is the price you pay,
        in USD.
      </p>
      <h2>Taxes — Canada</h2>
      <p>Any applicable sales tax is shown at checkout before you pay.</p>
      <h2>Questions</h2>
      <p>
        For anything about an order in transit, reach out from the address on your order
        confirmation.
      </p>
    </div>
  </TxShell>
</Base>

<style>
  .legal p {
    margin-top: 16px;
  }

  .legal-updated {
    margin-top: 0;
    color: var(--color-muted-foreground);
  }

  .legal h2 {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted-foreground);
  }

  .legal a {
    text-decoration: underline;
  }
</style>
