{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "**/alchemy.run.ts",
    "apps/platform.auth/api/worker.ts",
    "apps/platform.auth/app/worker.ts",
    "apps/platform.auth/app/start.ts",
    "apps/platform.auth/app/routeTree.gen.ts",
    "apps/platform.auth/api/schema.gen.ts",
    "apps/platform.auth/test/**/*.test.ts",
    // The deployed Worker's entry. React Router's own entries are discovered
    // by fallow's framework plugin, but this one is named as a STRING in
    // `module.ts` (`main`) precisely so the script exports the Durable Object
    // classes and the `email()` handler that the framework build does not.
    // No import reaches it, so without this line its whole tree reads as dead.
    "apps/platform.inbox/workers/app.ts",
    "packages/*/src/index.ts",
    "packages/*/test/**/*.test.ts",
    // A test fixture that is a real Astro app. Astro finds its routes,
    // middleware, actions and content config by directory scan, so no import
    // reaches them — same situation as the inbox Worker entry above. Declared
    // as entries rather than ignored, so the fixture's own imports still count
    // (otherwise `svelte` / `@astrojs/svelte` read as unused devDependencies).
    "packages/*/test/fixture/src/pages/**",
    "packages/*/test/fixture/src/middleware.ts",
    "packages/*/test/fixture/src/content.config.ts",
    "packages/*/test/fixture/src/actions/index.ts",
    "apps/*/src/server/entry.ts",
    "apps/*/src/shell/main.tsx",
    "apps/*/test/**/*.test.ts",
    "apps/*/integ/**/*.test.ts",
  ],
  // `email/preview/**` is the react-email dev harness: default exports the CLI
  // loads by directory scan, never imported, and not shipped.
  "ignorePatterns": [
    "dist/**",
    "design/**",
    "plugin/**",
    "**/scripts/**",
    "**/generated/**",
    "**/email/preview/**",
    "**/worktrees/**",
  ],
  // ── BOUNDARIES ───────────────────────────────────────────────────────────
  // Tiers, not units. The dot-namespace makes the tier readable off the
  // directory name: `platform.*` is platform, everything else is a product.
  //
  // ZONE ORDER IS SEMANTIC. A file belongs to the FIRST zone whose pattern
  // matches — which is why app-core precedes the app tiers, and why the
  // platform tiers precede nothing (their `platform.*` prefix already
  // disambiguates them).
  //
  // NO autoDiscover HERE, deliberately. It reads as the right tool — one child
  // zone per product, nothing written down per product — and it is not, because
  // both tiers share `apps/`. Verified experimentally against fallow 3.10:
  //   - autoDiscover mints a zone for EVERY immediate child of the named
  //     directory. It has no exclusion list, and a glob (`apps/*`) is rejected
  //     outright: "did not resolve to a readable directory".
  //   - So pointing it at `apps` also mints product-app/platform.auth,
  //     /platform.inbox, /platform.site. An earlier zone's explicit pattern
  //     does beat a later zone's discovered child, so those files land in
  //     platform-app correctly — but the phantom child zones survive and each
  //     one warns "matched 0 reachable files" on every run. Eight warnings for
  //     two autoDiscover parents.
  //   - A zone carrying BOTH `patterns` and autoDiscover keeps its patterns as
  //     a fallback zone that the children have already emptied — a ninth and
  //     tenth warning. Drop `patterns` and the fallback zone disappears.
  //   - `root` scopes `patterns` only, NOT autoDiscover, so it cannot narrow
  //     what gets discovered either.
  // Restoring autoDiscover means giving products a directory of their own
  // (`products/`, `product-stacks/`) so the discovered set is products-only.
  // Until then products are named here: two lines each, and the per-product
  // sealing below is real rather than implied.
  "boundaries": {
    "zones": [
      // Pure domain. Isolated, and barred from I/O below — which is what makes
      // a core testable without a Worker runtime. FIRST, so it wins over the
      // owning app's zone.
      { "name": "app-core", "patterns": ["apps/*/core/**", "apps/*/src/core/**"] },

      { "name": "lib", "patterns": ["packages/lib.*/**"] },
      { "name": "platform-pkg", "patterns": ["packages/platform.*/**"] },

      { "name": "platform-app", "patterns": ["apps/platform.*/**"] },
      // One zone per product, so products stay sealed from each other. Add a
      // zone AND a rule when a product lands; `coverage.requireAllFiles` below
      // turns a forgotten one into a finding rather than a silent free pass.
      { "name": "product-app/mezedes", "patterns": ["apps/mezedes/**"] },

      { "name": "platform-stack", "patterns": ["stacks/platform.*/**"] },
      { "name": "product-stack/mezedes", "patterns": ["stacks/mezedes/**"] },
    ],
    "rules": [
      { "from": "app-core", "allow": [] },
      { "from": "lib", "allow": [] },
      { "from": "platform-pkg", "allow": ["lib"] },
      { "from": "platform-app", "allow": ["app-core", "platform-pkg", "lib"] },
      {
        "from": "product-app/mezedes",
        "allow": ["app-core", "platform-app", "platform-pkg", "lib"],
      },
      { "from": "platform-stack", "allow": ["platform-app", "platform-pkg", "lib"] },
      // A product's stack reaches ITS product, not the product tier at large.
      // Under autoDiscover this could only be written as "product-app", which
      // expanded to every discovered product — so every product stack could
      // reach every product app.
      {
        "from": "product-stack/mezedes",
        "allow": ["product-app/mezedes", "platform-stack", "platform-app", "platform-pkg", "lib"],
      },
    ],
    // Segment-aware, and matched THROUGH imports — not globs.
    //
    // `*.ref` confines cross-stack resource refs to `apps/<ns>/binding.ts`,
    // because a ref's target is a STRING LITERAL that no import graph can see.
    // Still absent from the two product tiers — but now only because no product
    // mints a ref yet, not because the config could not say so. The zones above
    // are named, so this is a one-liner per product the day one does.
    "calls": {
      "forbidden": [
        {
          "from": "app-core",
          "callee": ["fetch", "caches.*", "crypto.subtle.*", "cloudflare:workers.*"],
        },
        { "from": "platform-app", "callee": "*.ref" },
        { "from": "platform-stack", "callee": "*.ref" },
        { "from": "platform-pkg", "callee": "*.ref" },
        { "from": "lib", "callee": "*.ref" },
      ],
    },
    // A file in a location no zone claims is a FINDING, not a silently
    // unrestricted file.
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["vite.config.ts", "tools/**"],
    },
  },
  "rules": {
    "boundary-violation": "error",
    "unused-exports": "error",
    "unused-files": "error",
    "unused-dependencies": "error",
  },
  // A method reached through a Durable Object STUB or invoked by a framework is
  // called by a name no import graph carries. The bare strings apply to every
  // class; the scoped entries apply only to a matching `extends`, which is the
  // form to prefer — a global `get` silences a genuinely dead `get` anywhere.
  "usedClassMembers": [
    "list",
    "get",
    "versionOf",
    "allocate",
    "commit",
    "update",
    "remove",
    "fetch",
    "alarm",
    // platform.inbox's mailbox. Every one of these has a real `stub.<name>()`
    // call site in `workers/`; fallow cannot follow a member through
    // `DurableObjectStub<MailboxDO>`. Listed rather than globbed on purpose:
    // a NEW method that never gets wired up should still fail the gate.
    {
      "extends": "DurableObject",
      "members": [
        "countEmails",
        "getThreadedEmails",
        "countThreadedEmails",
        "getThreadEmails",
        "updateEmail",
        "markThreadRead",
        "deleteEmail",
        "getAttachment",
        "getFolders",
        "createFolder",
        "updateFolder",
        "deleteFolder",
        "moveEmail",
        "searchEmails",
        "countSearchResults",
        "findThreadBySubject",
        "checkSendRateLimit",
        "createEmail",
      ],
    },
    // Lifecycle overrides the `agents` runtime calls, never the app.
    { "extends": "AIChatAgent", "members": ["onChatMessage", "onRequest"] },
    { "extends": "McpAgent", "members": ["init"] },
  ],
  "ignoreDependencies": [
    // Resolved at runtime by the `email dev` CLI, never imported. The old repo
    // carried the same entry for the same reason.
    "@react-email/preview-server",
    "@effect/platform-bun",
    "@effect/platform-node",
    "alchemy",
    "effect",
    "react",
    "react-dom",
  ],
}
